<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Limits_Not_Negative</fullName>
    <active>true</active>
    <description>Refund ceilings cannot be negative.</description>
    <errorConditionFormula>OR(Max_Refund__c &lt; 0, Clean_History_Max_Refund__c &lt; 0)</errorConditionFormula>
    <errorDisplayField>Max_Refund__c</errorDisplayField>
    <errorMessage>Refund limits cannot be negative.</errorMessage>
</ValidationRule>
