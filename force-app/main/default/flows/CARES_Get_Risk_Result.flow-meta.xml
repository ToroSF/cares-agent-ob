<?xml version='1.0' encoding='UTF-8' ?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
  <apiVersion>67.0</apiVersion>
  <assignments>
    <name>Add_One</name>
    <label>Add one</label>
    <locationX>250</locationX>
    <locationY>300</locationY>
    <assignmentItems>
      <assignToReference>issueCount</assignToReference>
      <operator>Add</operator>
      <value>
        <numberValue>1.0</numberValue>
      </value>
    </assignmentItems>
    <connector>
      <targetReference>Loop_Cases</targetReference>
    </connector>
  </assignments>
  <assignments>
    <name>Set_Clean</name>
    <label>Set CLEAN</label>
    <locationX>50</locationX>
    <locationY>500</locationY>
    <assignmentItems>
      <assignToReference>riskStatus</assignToReference>
      <operator>Assign</operator>
      <value>
        <stringValue>CLEAN</stringValue>
      </value>
    </assignmentItems>
  </assignments>
  <assignments>
    <name>Set_Not_Clean</name>
    <label>Set NOT_CLEAN</label>
    <locationX>250</locationX>
    <locationY>500</locationY>
    <assignmentItems>
      <assignToReference>riskStatus</assignToReference>
      <operator>Assign</operator>
      <value>
        <stringValue>NOT_CLEAN</stringValue>
      </value>
    </assignmentItems>
  </assignments>
  <assignments>
    <name>Set_Unknown</name>
    <label>Set UNKNOWN</label>
    <locationX>450</locationX>
    <locationY>200</locationY>
    <assignmentItems>
      <assignToReference>riskStatus</assignToReference>
      <operator>Assign</operator>
      <value>
        <stringValue>UNKNOWN</stringValue>
      </value>
    </assignmentItems>
  </assignments>
  <assignments>
    <name>Add_One_Account</name>
    <label>Add one (account-only)</label>
    <locationX>250</locationX>
    <locationY>390</locationY>
    <assignmentItems>
      <assignToReference>issueCount</assignToReference>
      <operator>Add</operator>
      <value>
        <numberValue>1.0</numberValue>
      </value>
    </assignmentItems>
    <connector>
      <targetReference>Loop_Account_Cases</targetReference>
    </connector>
  </assignments>
  <decisions>
    <name>Has_Contact</name>
    <label>Has contact and valid window</label>
    <locationX>50</locationX>
    <locationY>100</locationY>
    <defaultConnectorLabel>No</defaultConnectorLabel>
    <rules>
      <name>Yes</name>
      <conditionLogic>and</conditionLogic>
      <conditions>
        <leftValueReference>contactId</leftValueReference>
        <operator>IsBlank</operator>
        <rightValue>
          <booleanValue>false</booleanValue>
        </rightValue>
      </conditions>
      <conditions>
        <leftValueReference>lookbackDays</leftValueReference>
        <operator>GreaterThan</operator>
        <rightValue>
          <numberValue>0.0</numberValue>
        </rightValue>
      </conditions>
      <connector>
        <targetReference>Get_Contact</targetReference>
      </connector>
      <label>Yes</label>
    </rules>
  </decisions>
  <decisions>
    <name>Is_Clean</name>
    <label>Is clean</label>
    <locationX>50</locationX>
    <locationY>400</locationY>
    <defaultConnector>
      <targetReference>Set_Not_Clean</targetReference>
    </defaultConnector>
    <defaultConnectorLabel>Not clean</defaultConnectorLabel>
    <rules>
      <name>Zero_Issues</name>
      <conditionLogic>and</conditionLogic>
      <conditions>
        <leftValueReference>issueCount</leftValueReference>
        <operator>EqualTo</operator>
        <rightValue>
          <numberValue>0.0</numberValue>
        </rightValue>
      </conditions>
      <connector>
        <targetReference>Set_Clean</targetReference>
      </connector>
      <label>Zero issues</label>
    </rules>
  </decisions>
  <decisions>
    <name>Contact_Found</name>
    <label>Contact found</label>
    <locationX>50</locationX>
    <locationY>175</locationY>
    <defaultConnector>
      <targetReference>Set_Unknown</targetReference>
    </defaultConnector>
    <defaultConnectorLabel>Not found</defaultConnectorLabel>
    <rules>
      <name>Found</name>
      <conditionLogic>and</conditionLogic>
      <conditions>
        <leftValueReference>contactRecord.Id</leftValueReference>
        <operator>IsNull</operator>
        <rightValue>
          <booleanValue>false</booleanValue>
        </rightValue>
      </conditions>
      <connector>
        <targetReference>Get_Recent_Cases</targetReference>
      </connector>
      <label>Found</label>
    </rules>
  </decisions>
  <decisions>
    <name>Has_Account</name>
    <label>Contact has an account</label>
    <locationX>50</locationX>
    <locationY>350</locationY>
    <defaultConnector>
      <targetReference>Is_Clean</targetReference>
    </defaultConnector>
    <defaultConnectorLabel>No account</defaultConnectorLabel>
    <rules>
      <name>Yes_Account</name>
      <conditionLogic>and</conditionLogic>
      <conditions>
        <leftValueReference>contactRecord.AccountId</leftValueReference>
        <operator>IsNull</operator>
        <rightValue>
          <booleanValue>false</booleanValue>
        </rightValue>
      </conditions>
      <connector>
        <targetReference>Get_Other_Contact</targetReference>
      </connector>
      <label>Yes</label>
    </rules>
  </decisions>
  <decisions>
    <name>Only_Contact</name>
    <label>Contact is the only one on the account</label>
    <locationX>50</locationX>
    <locationY>370</locationY>
    <defaultConnector>
      <targetReference>Is_Clean</targetReference>
    </defaultConnector>
    <defaultConnectorLabel
    >Several contacts: do not count account-only cases</defaultConnectorLabel>
    <rules>
      <name>Is_Only</name>
      <conditionLogic>and</conditionLogic>
      <conditions>
        <leftValueReference>otherContact.Id</leftValueReference>
        <operator>IsNull</operator>
        <rightValue>
          <booleanValue>true</booleanValue>
        </rightValue>
      </conditions>
      <connector>
        <targetReference>Get_Account_Only_Cases</targetReference>
      </connector>
      <label>Only contact</label>
    </rules>
  </decisions>
  <description
  >CARES Risk Detection. Read-only. Counts a contact's issue cases in the last N days (plus account-only cases when the contact is the only one on the account) and returns CLEAN, NOT_CLEAN or UNKNOWN. Cases of type Refund / Compensation are ignored so a recovery made by CARES never makes the customer look risky. Any problem returns UNKNOWN.</description>
  <environments>Default</environments>
  <formulas>
    <name>windowStart</name>
    <dataType>DateTime</dataType>
    <expression>NOW() - {!lookbackDays}</expression>
  </formulas>
  <interviewLabel>CARES Get Risk Result</interviewLabel>
  <label>CARES Get Risk Result</label>
  <loops>
    <name>Loop_Cases</name>
    <label>Count cases</label>
    <locationX>50</locationX>
    <locationY>300</locationY>
    <collectionReference>recentCases</collectionReference>
    <iterationOrder>Asc</iterationOrder>
    <nextValueConnector>
      <targetReference>Add_One</targetReference>
    </nextValueConnector>
    <noMoreValuesConnector>
      <targetReference>Has_Account</targetReference>
    </noMoreValuesConnector>
  </loops>
  <loops>
    <name>Loop_Account_Cases</name>
    <label>Count account-only cases</label>
    <locationX>50</locationX>
    <locationY>390</locationY>
    <collectionReference>accountOnlyCases</collectionReference>
    <iterationOrder>Asc</iterationOrder>
    <nextValueConnector>
      <targetReference>Add_One_Account</targetReference>
    </nextValueConnector>
    <noMoreValuesConnector>
      <targetReference>Is_Clean</targetReference>
    </noMoreValuesConnector>
  </loops>
  <processMetadataValues>
    <name>BuilderType</name>
    <value>
      <stringValue>LightningFlowBuilder</stringValue>
    </value>
  </processMetadataValues>
  <processType>AutoLaunchedFlow</processType>
  <recordLookups>
    <name>Get_Recent_Cases</name>
    <label>Get recent issue cases</label>
    <locationX>50</locationX>
    <locationY>200</locationY>
    <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
    <connector>
      <targetReference>Loop_Cases</targetReference>
    </connector>
    <faultConnector>
      <targetReference>Set_Unknown</targetReference>
    </faultConnector>
    <filterLogic>and</filterLogic>
    <filters>
      <field>ContactId</field>
      <operator>EqualTo</operator>
      <value>
        <elementReference>contactId</elementReference>
      </value>
    </filters>
    <filters>
      <field>CreatedDate</field>
      <operator>GreaterThanOrEqualTo</operator>
      <value>
        <elementReference>windowStart</elementReference>
      </value>
    </filters>
    <filters>
      <field>Type</field>
      <operator>NotEqualTo</operator>
      <value>
        <stringValue>Refund / Compensation</stringValue>
      </value>
    </filters>
    <filters>
      <field>CARES_Escalation__c</field>
      <operator>EqualTo</operator>
      <value>
        <booleanValue>false</booleanValue>
      </value>
    </filters>
    <getFirstRecordOnly>false</getFirstRecordOnly>
    <object>Case</object>
    <storeOutputAutomatically>false</storeOutputAutomatically>
    <outputReference>recentCases</outputReference>
    <queriedFields>Id</queriedFields>
  </recordLookups>
  <recordLookups>
    <name>Get_Contact</name>
    <label>Get contact</label>
    <locationX>50</locationX>
    <locationY>150</locationY>
    <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
    <connector>
      <targetReference>Contact_Found</targetReference>
    </connector>
    <faultConnector>
      <targetReference>Set_Unknown</targetReference>
    </faultConnector>
    <filterLogic>and</filterLogic>
    <filters>
      <field>Id</field>
      <operator>EqualTo</operator>
      <value>
        <elementReference>contactId</elementReference>
      </value>
    </filters>
    <getFirstRecordOnly>true</getFirstRecordOnly>
    <object>Contact</object>
    <storeOutputAutomatically>false</storeOutputAutomatically>
    <outputReference>contactRecord</outputReference>
    <queriedFields>Id</queriedFields>
    <queriedFields>AccountId</queriedFields>
  </recordLookups>
  <recordLookups>
    <name>Get_Other_Contact</name>
    <label>Get another contact on the account</label>
    <locationX>50</locationX>
    <locationY>360</locationY>
    <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
    <connector>
      <targetReference>Only_Contact</targetReference>
    </connector>
    <faultConnector>
      <targetReference>Set_Unknown</targetReference>
    </faultConnector>
    <filterLogic>and</filterLogic>
    <filters>
      <field>AccountId</field>
      <operator>EqualTo</operator>
      <value>
        <elementReference>contactRecord.AccountId</elementReference>
      </value>
    </filters>
    <filters>
      <field>Id</field>
      <operator>NotEqualTo</operator>
      <value>
        <elementReference>contactId</elementReference>
      </value>
    </filters>
    <getFirstRecordOnly>true</getFirstRecordOnly>
    <object>Contact</object>
    <storeOutputAutomatically>false</storeOutputAutomatically>
    <outputReference>otherContact</outputReference>
    <queriedFields>Id</queriedFields>
  </recordLookups>
  <recordLookups>
    <name>Get_Account_Only_Cases</name>
    <label>Get account-only issue cases</label>
    <locationX>50</locationX>
    <locationY>380</locationY>
    <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
    <connector>
      <targetReference>Loop_Account_Cases</targetReference>
    </connector>
    <faultConnector>
      <targetReference>Set_Unknown</targetReference>
    </faultConnector>
    <filterLogic>and</filterLogic>
    <filters>
      <field>AccountId</field>
      <operator>EqualTo</operator>
      <value>
        <elementReference>contactRecord.AccountId</elementReference>
      </value>
    </filters>
    <filters>
      <field>ContactId</field>
      <operator>IsNull</operator>
      <value>
        <booleanValue>true</booleanValue>
      </value>
    </filters>
    <filters>
      <field>CreatedDate</field>
      <operator>GreaterThanOrEqualTo</operator>
      <value>
        <elementReference>windowStart</elementReference>
      </value>
    </filters>
    <filters>
      <field>Type</field>
      <operator>NotEqualTo</operator>
      <value>
        <stringValue>Refund / Compensation</stringValue>
      </value>
    </filters>
    <filters>
      <field>CARES_Escalation__c</field>
      <operator>EqualTo</operator>
      <value>
        <booleanValue>false</booleanValue>
      </value>
    </filters>
    <getFirstRecordOnly>false</getFirstRecordOnly>
    <object>Case</object>
    <storeOutputAutomatically>false</storeOutputAutomatically>
    <outputReference>accountOnlyCases</outputReference>
    <queriedFields>Id</queriedFields>
  </recordLookups>
  <runInMode>DefaultMode</runInMode>
  <start>
    <locationX>50</locationX>
    <locationY>0</locationY>
    <connector>
      <targetReference>Has_Contact</targetReference>
    </connector>
  </start>
  <status>Draft</status>
