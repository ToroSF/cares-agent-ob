    <decisions>
        <name>Use_Contact_Fallback</name>
        <label>No case for this chat, but a known contact?</label>
        <locationX>176</locationX>
        <locationY>350</locationY>
        <defaultConnector>
            <targetReference>Has_Case</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>caseBySession.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>session.EndUserContactId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Case_By_Contact</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Has_Case</name>
        <label>Case found?</label>
        <locationX>176</locationX>
        <locationY>550</locationY>
        <defaultConnector>
            <targetReference>Get_Support_Queue</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No: route without a case</defaultConnectorLabel>
        <rules>
            <name>Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>linkCaseId</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Link_Case</targetReference>
            </connector>
            <label>Found</label>
        </rules>
    </decisions>
    <description>CARES Escalate to Human, live chat only (D-084). Called by Omni-Channel when CARES escalates a real messaging session. Links the session to the CARES escalation case, so the person who accepts the chat sees the case summary next to the conversation, then routes the session to the CARES Support Chat queue (members: the CARES Support Team group). The case is found by its messaging session id; a reused case from an earlier chat is found by the session's contact. Any lookup problem still routes the chat: a person without the case is better than no person.</description>
    <environments>Default</environments>
    <formulas>
        <name>linkCaseId</name>
        <dataType>String</dataType>
        <expression>BLANKVALUE({!caseBySession.Id}, {!caseByContact.Id})</expression>
    </formulas>
