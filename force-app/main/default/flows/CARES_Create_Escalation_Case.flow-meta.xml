  <description
  >CARES Escalate to Human. Logs a fixed summary the person needs (category, reason, how the customer was identified, order, Stolen &amp; Delayed decision, risk status, offer, customer choice, messaging session, next step) so the customer does not have to repeat the story. The summary is built only from action variables, never from chat text (R-14). Playbook rules: if the contact already has an open CARES case for the same category and order, a private comment with the summary is added to it instead of a duplicate. New cases get Type, Reason, Priority and Status from the category, the contact's account, and go to the CARES Escalations queue when it exists. URGENT (food safety, harassment, fraud) is High priority. The summary is internal: the risk status must never be shown to the customer. Any problem creating the case returns success = false and no case number.</description>
  <environments>Default</environments>
  <formulas>
    <name>caseSubject</name>
    <dataType>String</dataType>
    <expression>CASE({!escalationCategory},
&quot;URGENT&quot;, &quot;CARES urgent escalation: safety or fraud&quot;,
&quot;PATTERN_REVIEW&quot;, &quot;CARES escalation: repeated issues review&quot;,
&quot;CLAIM_REVIEW&quot;, &quot;CARES escalation: delivery claim review&quot;,
&quot;CARES escalation&quot;)</expression>
  </formulas>
  <formulas>
    <name>caseType</name>
    <dataType>String</dataType>
    <expression>CASE({!escalationCategory},
&quot;CLAIM_REVIEW&quot;, &quot;Delivery &amp; Driver Issue&quot;,
&quot;Customer Order Issue&quot;)</expression>
  </formulas>
  <formulas>
    <name>caseReason</name>
    <dataType>String</dataType>
    <expression>CASE({!escalationCategory},
&quot;PATTERN_REVIEW&quot;, &quot;Fraud or policy review&quot;,
&quot;URGENT&quot;, &quot;Fraud or policy review&quot;,
&quot;&quot;)</expression>
  </formulas>
  <formulas>
    <name>casePriority</name>
    <dataType>String</dataType>
    <expression
    >CASE({!escalationCategory}, &quot;URGENT&quot;, &quot;High&quot;, &quot;Medium&quot;)</expression>
  </formulas>
  <formulas>
    <name>caseStatus</name>
    <dataType>String</dataType>
    <expression
    >CASE({!escalationCategory}, &quot;URGENT&quot;, &quot;Escalated&quot;, &quot;New&quot;)</expression>
  </formulas>
  <formulas>
    <name>caseOwnerId</name>
    <dataType>String</dataType>
    <expression
    >IF(ISBLANK({!queueRecord.Id}), {!$User.Id}, {!queueRecord.Id})</expression>
  </formulas>
  <formulas>
    <name>orderRef</name>
    <dataType>String</dataType>
    <expression>BLANKVALUE({!orderId}, &quot;NONE&quot;)</expression>
  </formulas>
  <formulas>
    <description
    >Fixed reason code from the agent script. Blank when an older agent version calls the Flow.</description>
    <name>reasonCode</name>
    <dataType>String</dataType>
    <expression
    >BLANKVALUE({!escalationReason}, &quot;NOT_GIVEN&quot;)</expression>
  </formulas>
  <formulas>
    <name>categoryLabel</name>
    <dataType>String</dataType>
    <expression
    >BLANKVALUE({!escalationCategory}, &quot;GENERAL&quot;)</expression>
  </formulas>
  <formulas>
    <name>reasonText</name>
    <dataType>String</dataType>
    <expression>CASE({!reasonCode},
&quot;SAFETY&quot;, &quot;Safety, health, fraud or legal report&quot;,
&quot;REPEATED_ISSUES&quot;, &quot;Repeated issues in the last 30 days, a person reviews before any offer&quot;,
&quot;CLAIM_REVIEW&quot;, &quot;The delivery claim needs a person to decide&quot;,
&quot;IDENTITY_FAILED&quot;, &quot;The customer could not be identified by email&quot;,
&quot;ISSUE_FAILED&quot;, &quot;The refund or credit could not be issued&quot;,
&quot;NOT_ELIGIBLE&quot;, &quot;No automatic offer was possible&quot;,
&quot;OFFER_DISPUTED&quot;, &quot;The customer disputes the offer or the outcome&quot;,
&quot;ORDER_NOT_FOUND&quot;, &quot;The order was not found after 3 tries&quot;,
&quot;CLAIM_FAILED&quot;, &quot;The delivery claim hand-off was blocked or failed&quot;,
&quot;CUSTOMER_REQUEST&quot;, &quot;The customer asked for a person&quot;,
&quot;Not given&quot;) &amp; &quot; (&quot; &amp; {!reasonCode} &amp; &quot;)&quot;</expression>
  </formulas>
  <formulas>
    <description
    >The channel contact is the signed-in chat user. Any other contact came from the email lookup (D-058).</description>
    <name>customerCheck</name>
    <dataType>String</dataType>
    <expression>IF(ISBLANK({!contactId}), &quot;Unknown: no contact found&quot;,
IF({!contactId} = {!channelContactId}, &quot;Verified (signed in to the chat)&quot;,
&quot;Found by email (the chat was not signed in)&quot;))</expression>
  </formulas>
  <formulas>
    <name>orderLabel</name>
    <dataType>String</dataType>
    <expression>BLANKVALUE({!orderId}, &quot;none given&quot;)</expression>
  </formulas>
  <formulas>
    <name>stolenDelayedLabel</name>
    <dataType>String</dataType>
    <expression>IF(ISBLANK({!stolenDelayedDecision}), &quot;not run&quot;,
{!stolenDelayedDecision} &amp; &quot; (&quot; &amp; BLANKVALUE({!stolenDelayedReason}, &quot;no reason&quot;) &amp; &quot;)&quot;)</expression>
  </formulas>
  <formulas>
    <name>riskLabel</name>
    <dataType>String</dataType>
    <expression>BLANKVALUE({!riskStatus}, &quot;UNKNOWN&quot;)</expression>
  </formulas>
  <formulas>
    <name>sentimentLabel</name>
    <dataType>String</dataType>
    <expression
    >BLANKVALUE({!customerSentiment}, &quot;not assessed&quot;)</expression>
  </formulas>
  <formulas>
    <name>customerSummaryLabel</name>
    <dataType>String</dataType>
    <expression
    >BLANKVALUE({!customerSummary}, &quot;not recorded&quot;)</expression>
  </formulas>
  <formulas>
    <name>offerLabel</name>
    <dataType>String</dataType>
    <expression
    >IF(AND(OR(ISBLANK({!offerAmount}), {!offerAmount} = 0), OR(ISBLANK({!creditAmount}), {!creditAmount} = 0)), &quot;none made&quot;,
&quot;refund &quot; &amp; TEXT({!offerAmount}) &amp; &quot;, credit &quot; &amp; TEXT({!creditAmount}) &amp; IF(ISBLANK({!currencyCode}), &quot;&quot;, &quot; &quot; &amp; {!currencyCode}))</expression>
  </formulas>
  <formulas>
    <name>choiceLabel</name>
    <dataType>String</dataType>
    <expression
    >BLANKVALUE({!chosenResolution}, &quot;nothing confirmed&quot;)</expression>
  </formulas>
  <formulas>
    <name>sessionLabel</name>
    <dataType>String</dataType>
    <expression
    >IF(ISBLANK({!sessionId}), &quot;none (not a live chat, so no transfer)&quot;,
&quot;messaging session &quot; &amp; {!sessionId} &amp; &quot; (live chat, transfer requested)&quot;)</expression>
  </formulas>
  <formulas>
    <name>nextStep</name>
    <dataType>String</dataType>
    <expression>CASE({!escalationCategory},
&quot;URGENT&quot;, &quot;Contact the customer now. Safety first: no offer before a person reviews.&quot;,
&quot;PATTERN_REVIEW&quot;, &quot;Review the customer&apos;s recent issue cases before any offer.&quot;,
&quot;CLAIM_REVIEW&quot;, &quot;Review the delivery claim and decide refund, credit or re-dispatch.&quot;,
&quot;Reply to the customer and resolve the request.&quot;)</expression>
  </formulas>
