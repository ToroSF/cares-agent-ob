  <textTemplates>
    <description
    >The internal summary for the person who takes over. One fact per line, only from variables.</description>
    <name>caseSummary</name>
    <isViewedAsPlainText>true</isViewedAsPlainText>
    <text
    >Escalated by CARES. Internal only: never share the risk status with the customer.
Category: {!categoryLabel}
Priority: {!casePriority}
Why: {!reasonText}
Customer said: {!customerSummaryLabel}
Customer: {!customerCheck}
Order: {!orderLabel}
Stolen &amp; Delayed check: {!stolenDelayedLabel}
Risk status (internal): {!riskLabel}
Customer sentiment (internal, as perceived by CARES): {!sentimentLabel}
Offer: {!offerLabel}
Customer chose: {!choiceLabel}
Chat: {!sessionLabel}
Next step: {!nextStep}</text>
  </textTemplates>
