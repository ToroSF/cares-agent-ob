  <description>CARES Escalate to Human. Logs the context the person needs (category, order, Stolen &amp; Delayed decision and reason, risk status, offer, customer choice) so the customer does not have to repeat the story. Playbook rules: if the contact already has an open CARES case for the same category and order, a private comment is added to it instead of a duplicate. New cases get Type, Reason, Priority and Status from the category and go to the CARES Escalations queue when it exists. URGENT (food safety, harassment, fraud) is High priority. The description is internal: the risk status must never be shown to the customer. Any problem creating the case returns success = false and no case number.</description>
  <environments>Default</environments>
  <formulas>
    <name>caseDescription</name>
    <dataType>String</dataType>
    <expression>&quot;Escalated by CARES.&quot; &amp;
&quot; Category: &quot; &amp; BLANKVALUE({!escalationCategory}, &quot;GENERAL&quot;) &amp; &quot;.&quot; &amp;
&quot; Order: &quot; &amp; BLANKVALUE({!orderId}, &quot;unknown&quot;) &amp; &quot;.&quot; &amp;
&quot; Stolen &amp; Delayed decision: &quot; &amp; BLANKVALUE({!stolenDelayedDecision}, &quot;none&quot;) &amp; &quot; (&quot; &amp; BLANKVALUE({!stolenDelayedReason}, &quot;no reason&quot;) &amp; &quot;).&quot; &amp;
&quot; Risk status: &quot; &amp; BLANKVALUE({!riskStatus}, &quot;UNKNOWN&quot;) &amp; &quot;.&quot; &amp;
&quot; Offer: refund &quot; &amp; TEXT({!offerAmount}) &amp; &quot;, credit &quot; &amp; TEXT({!creditAmount}) &amp; IF(ISBLANK({!currencyCode}), &quot;&quot;, &quot; &quot; &amp; {!currencyCode}) &amp; &quot;.&quot; &amp;
&quot; Customer chose: &quot; &amp; BLANKVALUE({!chosenResolution}, &quot;nothing confirmed&quot;) &amp; &quot;.&quot; &amp;
&quot; Internal only: never share the risk status with the customer.&quot;</expression>
  </formulas>
  <formulas>
    <name>caseSubject</name>
    <dataType>String</dataType>
    <expression>CASE({!escalationCategory},
&quot;URGENT&quot;, &quot;CARES urgent escalation: safety or fraud&quot;,
&quot;PATTERN_REVIEW&quot;, &quot;CARES escalation: repeated issues review&quot;,
&quot;CLAIM_REVIEW&quot;, &quot;CARES escalation: delivery claim review&quot;,
&quot;CARES escalation&quot;)</expression>
  </formulas>
  <formulas>
    <name>caseType</name>
    <dataType>String</dataType>
    <expression>CASE({!escalationCategory},
&quot;CLAIM_REVIEW&quot;, &quot;Delivery &amp; Driver Issue&quot;,
&quot;Customer Order Issue&quot;)</expression>
  </formulas>
  <formulas>
    <name>caseReason</name>
    <dataType>String</dataType>
    <expression>CASE({!escalationCategory},
&quot;PATTERN_REVIEW&quot;, &quot;Fraud or policy review&quot;,
&quot;URGENT&quot;, &quot;Fraud or policy review&quot;,
&quot;&quot;)</expression>
  </formulas>
  <formulas>
    <name>casePriority</name>
    <dataType>String</dataType>
    <expression>CASE({!escalationCategory}, &quot;URGENT&quot;, &quot;High&quot;, &quot;Medium&quot;)</expression>
  </formulas>
  <formulas>
    <name>caseStatus</name>
    <dataType>String</dataType>
    <expression>CASE({!escalationCategory}, &quot;URGENT&quot;, &quot;Escalated&quot;, &quot;New&quot;)</expression>
  </formulas>
  <formulas>
    <name>caseOwnerId</name>
    <dataType>String</dataType>
    <expression>IF(ISBLANK({!queueRecord.Id}), {!$User.Id}, {!queueRecord.Id})</expression>
  </formulas>
  <formulas>
    <name>orderRef</name>
    <dataType>String</dataType>
    <expression>BLANKVALUE({!orderId}, &quot;NONE&quot;)</expression>
  </formulas>
