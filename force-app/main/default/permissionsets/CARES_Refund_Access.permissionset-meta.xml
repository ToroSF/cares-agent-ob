<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>CARES Refund Access</label>
    <description>Grants the Einstein Agent User running CARES access to the Refund sub-agent's invocable Apex actions. Assignment is an explicit rollout step, not a side effect of deploying the agent.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <classAccesses>
        <apexClass>CARES_Refund_CalculateOffer</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>CARES_Refund_FindOrder</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>CARES_Refund_IssueResolution</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>CARES_Refund_LogOrderIssue</apexClass>
        <enabled>true</enabled>
    </classAccesses>
</PermissionSet>
