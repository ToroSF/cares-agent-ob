<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>CARES Experience Rating Access</label>
    <description>Grants the Einstein Agent User running CARES the object and field access needed for the Experience Rating sub-agent to create CSAT_Rating__c records via "insert as user". NOT YET ASSIGNED to any user and NOT YET DEPLOYED — prepared here so review/assignment is an explicit step in a later rollout pass, not an implicit side effect of deploying the agent.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <objectPermissions>
        <object>CSAT_Rating__c</object>
        <allowCreate>true</allowCreate>
        <allowRead>true</allowRead>
        <allowEdit>false</allowEdit>
        <allowDelete>false</allowDelete>
        <viewAllRecords>false</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>
    <fieldPermissions>
        <field>CSAT_Rating__c.Score__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>CSAT_Rating__c.Comment__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>CSAT_Rating__c.Contact__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>CSAT_Rating__c.Account__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>CSAT_Rating__c.Interaction_Date__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
</PermissionSet>
